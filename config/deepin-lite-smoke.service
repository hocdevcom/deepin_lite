[Unit]
Description=Deepin Lite CI live desktop check
ConditionVirtualization=qemu
After=display-manager.service NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/deepin-lite/live-smoke.sh
TimeoutStartSec=900
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0

[Install]
WantedBy=multi-user.target
